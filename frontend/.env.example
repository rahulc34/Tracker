# Desktop dev (default)
NEXT_PUBLIC_TRACKER_API_URL=http://localhost:4001

# Production — set to your public API URL (browser-reachable):
# NEXT_PUBLIC_TRACKER_API_URL=https://api.yourdomain.com

# Optional: extra Next.js dev origins (comma-separated hostnames)
# TRACKER_DEV_ALLOWED_ORIGINS=192.168.0.117

NEXT_PUBLIC_DEFAULT_USER_ID=00000000-0000-4000-8000-000000000001
