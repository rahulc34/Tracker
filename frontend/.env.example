# Desktop dev (default)
NEXT_PUBLIC_TRACKER_API_URL=http://localhost:4001

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Production — set to your public API URL (browser-reachable):
# NEXT_PUBLIC_TRACKER_API_URL=https://api.yourdomain.com

# Optional: extra Next.js dev origins (comma-separated hostnames)
# TRACKER_DEV_ALLOWED_ORIGINS=192.168.0.117

# Dev only — skip Supabase auth on the API (local testing without login)
# AUTH_DISABLED=true on the backend matches this flow
