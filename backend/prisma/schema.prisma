generator client {
  provider = "prisma-client-js"
  // Isolated client — TestPulse backend also uses @prisma/client for its own schema.
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  // Pooled URL (Supabase transaction pooler, port 6543) for the running API.
  url       = env("DATABASE_URL")
  // Direct URL (Supabase session mode, port 5432) for migrations and Prisma Studio.
  directUrl = env("DIRECT_URL")
}

enum SkillScope {
  yearly
  monthly
}

enum SkillTag {
  skill
  project
  personal
}

enum ResourceType {
  folder
  link
  note
  file
}

enum AssignmentStatus {
  in_progress
  completed
  overdue
}

enum AssignmentEventType {
  created
  reassigned
  completed
}

enum AssignmentEventStatus {
  started
  incomplete
  in_progress
  completed
}

enum BookmarkCategory {
  vault
  profile
}

enum VaultItemKind {
  folder
  link
}

model TrackerUser {
  id             String   @id @db.Uuid
  supabaseAuthId String?  @unique @map("supabase_auth_id") @db.Uuid
  email          String?
  name           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  years     Year[]
  bookmarks UserBookmark[]

  @@map("tracker_users")
}

model UserBookmark {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  category  BookmarkCategory
  kind      VaultItemKind    @default(link)
  parentId  String?          @map("parent_id") @db.Uuid
  platform  String
  title     String
  url       String?
  note      String?
  sortOrder Int              @default(0) @map("sort_order")
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  user     TrackerUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   UserBookmark?  @relation("VaultTree", fields: [parentId], references: [id], onDelete: Cascade)
  children UserBookmark[] @relation("VaultTree")

  @@index([userId, category])
  @@index([userId, category, platform])
  @@index([parentId])
  @@map("user_bookmarks")
}

model Year {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  yearNumber Int      @map("year_number")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  user   TrackerUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  months Month[]
  skills Skill[]

  @@unique([userId, yearNumber])
  @@index([userId])
  @@map("years")
}

model Month {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  yearId     String   @map("year_id") @db.Uuid
  monthIndex Int      @map("month_index")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  year        Year              @relation(fields: [yearId], references: [id], onDelete: Cascade)
  assignments MonthAssignment[]

  @@unique([yearId, monthIndex])
  @@index([yearId])
  @@map("months")
}

model Skill {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  yearId        String     @map("year_id") @db.Uuid
  parentSkillId String?    @map("parent_skill_id") @db.Uuid
  scope         SkillScope
  title         String
  description   String?
  tag           SkillTag   @default(skill)
  isCompleted   Boolean    @default(false) @map("is_completed")
  progress      Int        @default(0)
  estimatedDays Int?       @map("estimated_days")
  startedAt     DateTime?  @map("started_at") @db.Timestamptz
  sortOrder     Int        @default(0) @map("sort_order")
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  year        Year              @relation(fields: [yearId], references: [id], onDelete: Cascade)
  parent      Skill?            @relation("SkillTree", fields: [parentSkillId], references: [id], onDelete: Cascade)
  subSkills   Skill[]           @relation("SkillTree")
  resources   SkillResource[]
  assignments MonthAssignment[]

  @@index([yearId, scope])
  @@index([parentSkillId])
  @@map("skills")
}

model SkillResource {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  skillId   String       @map("skill_id") @db.Uuid
  parentId  String?      @map("parent_id") @db.Uuid
  type      ResourceType
  title     String
  url       String?
  content   String?      @db.Text
  sortOrder Int          @default(0) @map("sort_order")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz

  skill    Skill           @relation(fields: [skillId], references: [id], onDelete: Cascade)
  parent   SkillResource?  @relation("ResourceTree", fields: [parentId], references: [id], onDelete: Cascade)
  children SkillResource[] @relation("ResourceTree")

  @@index([skillId])
  @@index([parentId])
  @@map("skill_resources")
}

model MonthAssignment {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  skillId           String           @map("skill_id") @db.Uuid
  monthId           String           @map("month_id") @db.Uuid
  status            AssignmentStatus @default(in_progress)
  currentTargetDate DateTime?        @map("current_target_date") @db.Date
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz

  skill    Skill              @relation(fields: [skillId], references: [id], onDelete: Cascade)
  month    Month              @relation(fields: [monthId], references: [id], onDelete: Cascade)
  events   AssignmentEvent[]
  datePins DatePin[]

  @@unique([skillId, monthId])
  @@index([monthId])
  @@index([skillId])
  @@map("month_assignments")
}

model AssignmentEvent {
  id           String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assignmentId String                @map("assignment_id") @db.Uuid
  eventDate    DateTime              @map("event_date") @db.Date
  eventType    AssignmentEventType   @map("event_type")
  status       AssignmentEventStatus
  note         String?
  sequence     Int

  assignment MonthAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId, sequence])
  @@map("assignment_events")
}

model DatePin {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assignmentId   String   @map("assignment_id") @db.Uuid
  pinnedDate     DateTime @map("pinned_date") @db.Date
  isReassignment Boolean  @default(false) @map("is_reassignment")

  assignment MonthAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@index([pinnedDate])
  @@map("date_pins")
}
