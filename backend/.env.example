# --- Supabase (recommended) ---
# Project Settings → Database → Connection string
#
# DATABASE_URL  = Transaction pooler (port 6543) — add ?pgbouncer=true
# DIRECT_URL    = Session pooler or direct connection (port 5432)
#
# Copy BOTH strings from Supabase → Project Settings → Database → Connect (do not use db.[ref].supabase.co — that host often does not resolve).
# Example (replace [ref], [password], [region] from the dashboard):
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

DATABASE_URL=
DIRECT_URL=

# --- Local Postgres (optional) — use the same URL for both, or omit DIRECT_URL ---
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/tracker
# DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/tracker

# Optional. Defaults to 4001.
PORT=4001

# Comma-separated CORS origins. Phone testing on 192.168.x.x is auto-allowed in dev.
CORS_ORIGINS=http://localhost:3001

# Supabase Auth — Project Settings → API (service_role: server only, never expose to frontend)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Local dev without login (optional). Do not use in production.
# AUTH_DISABLED=true
# DEFAULT_USER_ID=00000000-0000-4000-8000-000000000001
