# Postgres — use YOUR local Postgres credentials (same server as TestPulse is fine).
# 1. Create an empty database named "tracker" in pgAdmin
# 2. Paste your connection string here (URL-encode special chars in password: @ → %40, # → %23)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/tracker

# Optional. Defaults to 4001.
PORT=4001

# Comma-separated CORS origins. Phone testing on 192.168.x.x is auto-allowed in dev.
# Use * only if you need to allow every origin locally.
CORS_ORIGINS=http://localhost:3001
