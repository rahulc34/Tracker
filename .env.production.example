# Copy to .env before: docker compose --env-file .env up -d --build
# Or use for manual deploy with Supabase (no local Postgres container).

# --- Supabase (recommended) ---
# From Supabase → Project Settings → Database → Connection string
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# --- Local Postgres (Docker Compose profile "local-db" only) ---
# POSTGRES_USER=tracker
# POSTGRES_PASSWORD=change-me-strong-password
# POSTGRES_DB=tracker

# --- Public URLs (what the browser uses — NOT docker service names) ---
PUBLIC_WEB_URL=http://YOUR_SERVER_IP:3001
PUBLIC_API_URL=http://YOUR_SERVER_IP:4001

NEXT_PUBLIC_TRACKER_API_URL=http://YOUR_SERVER_IP:4001
CORS_ORIGINS=http://YOUR_SERVER_IP:3001

WEB_PORT=3001
API_PORT=4001

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
