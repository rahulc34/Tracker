# Copy to .env before: docker compose --env-file .env up -d --build

# --- Postgres ---
POSTGRES_USER=tracker
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=tracker

# --- Public URLs (what the browser uses — NOT docker service names) ---
# VPS / home server example:
PUBLIC_WEB_URL=http://YOUR_SERVER_IP:3001
PUBLIC_API_URL=http://YOUR_SERVER_IP:4001

# Domain example:
# PUBLIC_WEB_URL=https://pulse.yourdomain.com
# PUBLIC_API_URL=https://api.yourdomain.com

NEXT_PUBLIC_TRACKER_API_URL=http://YOUR_SERVER_IP:4001
CORS_ORIGINS=http://YOUR_SERVER_IP:3001

# Optional ports on the host
WEB_PORT=3001
API_PORT=4001

# Demo user id (seed optional)
NEXT_PUBLIC_DEFAULT_USER_ID=00000000-0000-4000-8000-000000000001
