{
  "name": "pulse-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Pulse Tracker — Next.js frontend + Express API + Supabase PostgreSQL.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0 <23.0.0",
    "npm": ">=10"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace @tracker/backend",
    "dev:frontend": "npm run dev --workspace @tracker/frontend",
    "build:backend": "npm run build --workspace @tracker/backend",
    "build:frontend": "npm run build --workspace @tracker/frontend",
    "build": "npm run build:backend && npm run build:frontend",
    "start:render": "bash scripts/render-start.sh",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "prisma:generate": "npm run prisma:generate --workspace @tracker/backend",
    "prisma:migrate": "npm run prisma:migrate --workspace @tracker/backend",
    "prisma:seed": "npm run prisma:seed --workspace @tracker/backend",
    "dev:tracker-backend": "npm run dev:backend",
    "dev:tracker-frontend": "npm run dev:frontend",
    "tracker:prisma:migrate": "npm run prisma:migrate",
    "tracker:prisma:generate": "npm run prisma:generate",
    "tracker:prisma:seed": "npm run prisma:seed",
    "docker:up": "docker compose --env-file .env up -d --build",
    "docker:down": "docker compose --env-file .env down",
    "docker:logs": "docker compose --env-file .env logs -f"
  }
}
